{
  "name": "pi-worktree-tools",
  "version": "0.2.0",
  "description": "pi-coding-agent extension: agent-callable git worktree tools with automatic cwd sync and shutdown cleanup",
  "type": "module",
  "keywords": [
    "pi-package",
    "worktrees"
  ],
  "main": "src/index.ts",
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
